# TinyFish API key — get one at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=sk-tinyfish-your-key-here

# Google Gemini API key — get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AgentQL API key — get one at https://agentql.com/ (optional if using Playwright / TinyFish CDP directly)
AGENTQL_API_KEY=your_agentql_api_key_here

# Modal Serverless GPU credentials (or authenticate via `modal setup`)
MODAL_TOKEN_ID=your_modal_token_id_here
MODAL_TOKEN_SECRET=your_modal_token_secret_here

# System Configuration
# PORTAL_MODE: "LIVE" or "HYBRID_FALLBACK" (transparently fails over to local mock portals after 4.0s timeout)
PORTAL_MODE=HYBRID_FALLBACK
PORTAL_TIMEOUT_SECONDS=4.0
